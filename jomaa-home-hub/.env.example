# Copy to .env and fill in. .env is never committed.
HUB_PASSWORD=change-me
GOVEE_API_KEY=
# Where hubctl reaches the hub. Change if you moved "listen" in config.json.
HUB_URL=http://127.0.0.1:8080
# Optional: put the hub on the internet through a Cloudflare Tunnel.
# The tunnel comes up when both of these are set. The token needs Account >
# Cloudflare Tunnel > Edit, Zone > DNS > Edit and Zone > Zone > Read.
CLOUDFLARE_HOSTNAME=
CLOUDFLARE_API_TOKEN=
# Optional overrides:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_TUNNEL_NAME=jomaa-home-hub
# CLOUDFLARE_TUNNEL_SERVICE=http://localhost:8080
# Health inventory and logs (Node >=22.13, built-in SQLite).
HEALTH_DB_PATH=data/health.sqlite
HEALTH_RETENTION_DAYS=30
# Optional direct HTTPS listener. Set both paths together; otherwise use the local HTTPS tunnel.
# HUB_TLS_CERT=/path/to/hub-fullchain.pem
# HUB_TLS_KEY=/path/to/hub-key.pem
