{
  "name": "jomaa-home-hub",
  "private": true,
  "description": "One hub for every light in the house, Matter or Govee",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@matter-server/custom-clusters": "1.5.5",
    "@matter-server/ws-controller": "1.5.5",
    "@matter/main": "0.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
