{
  "name": "hub",
  "inputs": [
    "jomaa-deploy/boot.py",
    "jomaa-deploy/config.json",
    "jomaa-static-pages/device-panel",
    "jomaa-images",
    "pico-imaging-bench"
  ],
  "checks": [
    ["{python}", "scripts/verify.py"],
    ["npm", "run", "test:browser"]
  ],
  "state": ["jomaa-home-hub/.env", "jomaa-home-hub/config.json", "jomaa-home-hub/data"],
  "unit": "jomaa-hub",
  "origin": "http://127.0.0.1:8080",
  "command": ["{python}", "{release}/jomaa-deploy/boot.py", "hub"],
  "build": [
    ["npm", "ci", "--no-audit", "--no-fund"],
    ["npm", "run", "build"]
  ],
  "health": {
    "path": "/healthz",
    "json": {
      "ok": true,
      "matterConnected": true
    }
  },
  "routes": [
    {
      "hostname": "hub.jomaa.org"
    },
    {
      "hostname": "jomaa.org",
      "path": "^/(home(/.*)?|manage(/.*)?|lights(/.*)?|invite(/.*)?|join(/.*)?|permissions(/.*)?|secrets(/.*)?|api/(login|logout|session|join|prefetch|clicks|invites(/.*)?|accounts(/.*)?|secrets(/.*)?|manage|targets(/.*)?|devices(/.*)?|picos(/.*)?|matter/(discover|register|nodes/[1-9][0-9]*/(name|group))))?$",
      "probes": [
        "/",
        "/home",
        "/home/style.css",
        "/manage",
        "/manage/app.js",
        "/manage/style.css",
        "/api/manage",
        "/api/devices",
        "/api/matter/discover",
        "/api/matter/register",
        "/api/matter/nodes/1/name",
        "/api/matter/nodes/1/group",
        "/lights",
        "/lights/app.js",
        "/api/login",
        "/api/logout",
        "/api/targets/living-room/state",
        "/home/accounts.js",
        "/invite",
        "/invite/app.js",
        "/join",
        "/join/app.js",
        "/permissions",
        "/permissions/app.js",
        "/api/session",
        "/api/join",
        "/api/invites",
        "/api/invites/check",
        "/api/accounts",
        "/api/accounts/someone/scopes",
        "/secrets",
        "/secrets/app.js",
        "/secrets/style.css",
        "/api/secrets",
        "/api/secrets/reveal",
        "/api/secrets/redeploy",
        "/api/secrets/redeploy/1",
        "/home/ui.css",
        "/home/ui.js",
        "/manage/health.js",
        "/home/prefetch.js",
        "/api/prefetch",
        "/api/clicks",
        "/manage/picos.js",
        "/manage/picos.css",
        "/api/picos",
        "/api/picos/catalog",
        "/api/picos/selected/state",
        "/api/picos/selected/flash",
        "/api/picos/runs/result"
      ]
    }
  ]
}
