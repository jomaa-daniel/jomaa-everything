{
  "accounts": {
    "databaseFile": "accounts.sqlite",
    "sessionLifetimeDays": 30,
    "sessionsPerAccount": 20,
    "inviteLifetimeDays": 7,
    "passwordLength": {
      "min": 12,
      "max": 256
    }
  },
  "secrets": {
    "envFiles": ["jomaa-home-hub/.env", "jomaa-tailscale/.env"],
    "ghCommand": "/snap/bin/gh",
    "deployConfig": "jomaa-deploy/config.json",
    "redeployPollSeconds": 5
  }
}
