{
  "accounts": {
    "databaseFile": "accounts.sqlite",
    "sessionLifetimeDays": 30,
    "sessionsPerAccount": 20,
    "inviteLifetimeDays": 7,
    "inviteChartDays": 30,
    "passwordLength": {
      "min": 12,
      "max": 256
    }
  },
  "i2c": {
    "maxDataBytes": 4096,
    "maxRequestBytes": 12288,
    "historyLimit": 100,
    "liveRows": 200,
    "keepaliveSeconds": 15,
    "reconnectMilliseconds": 2000,
    "maxLiveClients": 32
  },
  "prefetch": {
    "databaseFile": "clicks.sqlite",
    "concurrency": 2
  },
  "secrets": {
    "envFiles": ["jomaa-home-hub/.env", "jomaa-tailscale/.env"],
    "ghCommand": "/snap/bin/gh",
    "deployConfig": "jomaa-deploy/config.json",
    "redeployPollSeconds": 5
  },
  "health": {
    "refreshSeconds": 15,
    "historyLimit": 50,
    "discoveryRefreshSeconds": 2,
    "goveeStatusCacheSeconds": 60,
    "goveeStatusConcurrency": 2,
    "goveeStatusTimeoutSeconds": 10
  },
  "cameraConfigFile": "jomaa-cameras/config.json",
  "cameraMonitoringConfigFile": "jomaa-frigate/config.json"
}
